@Library("Infrastructure") _

def product = "appreg"
def type = "java"
def component = "performance"

def testVaultUrl = 'https://appreg-kv-test.vault.azure.net/'
def initialTestUserEmail = 'appreg-001@dev.platform.hmcts.net'

properties([
  parameters([
    choice(
      name: 'RUN_MODE',
      choices: ['framework-proof', 'application-diagnostic', 'performance'],
      description: 'Select the execution type.\n'
        + 'framework-proof: Run twelve business proofs sequentially with one authenticated session.\n'
        + 'application-diagnostic: Run a configurable bounded seeded workload.\n'
        + 'performance: Run the canonical seeded 500-actor NFR workload.'
    ),
    string(
      name: 'MAX_USERS',
      defaultValue: '10',
      description: 'Concurrent workload actors.\n'
        + 'framework-proof: Not used; the proof uses one actor.\n'
        + 'application-diagnostic: Between 1 and 500; default 10.\n'
        + 'performance: Not used; always 500.'
    ),
    string(
      name: 'SESSION_POOL_SIZE',
      defaultValue: '',
      description: 'Authenticated sessions shared round-robin by workload actors.\n'
        + 'framework-proof: Not used; the proof uses one session.\n'
        + 'application-diagnostic: Between 1 and MAX_USERS; blank uses MAX_USERS.\n'
        + 'performance: Between 1 and 500; blank uses 100.'
    ),
    string(
      name: 'AUTHENTICATION_RATE_PER_SECOND',
      defaultValue: '0.15',
      description: 'Progressive SSO journeys started per second during workload setup.\n'
        + 'framework-proof: Not used.\n'
        + 'application-diagnostic: Greater than 0 and no more than 1; default 0.15.\n'
        + 'performance: Greater than 0 and no more than 1; default 0.15 (about 667 seconds for 100 sessions).'
    ),
    string(
      name: 'RUN_DURATION_MINUTES',
      defaultValue: '30',
      description: 'Measured steady-state workload duration.\n'
        + 'framework-proof: Not used.\n'
        + 'application-diagnostic: Between 1 and 70 minutes; MAX_USERS multiplied by minutes must not exceed 35,000.\n'
        + 'performance: Between 1 and 70 minutes; default 30.'
    ),
    string(
      name: 'ACTION_PACE_SECONDS',
      defaultValue: '60',
      description: 'Minimum interval between business-action starts for each workload actor.\n'
        + 'framework-proof: Not used.\n'
        + 'application-diagnostic: Between 60 and 3,600 seconds; default 60.\n'
        + 'performance: Between 60 and 3,600 seconds; default 60.'
    ),
    string(
      name: 'ACTION_SPREAD_SECONDS',
      defaultValue: '60',
      description: 'Interval across which deterministic initial actor offsets are distributed.\n'
        + 'framework-proof: Not used.\n'
        + 'application-diagnostic: Between 0 and 3,600 seconds; default 60; zero starts all actors together.\n'
        + 'performance: Between 0 and 3,600 seconds; default 60; zero starts all actors together.'
    ),
    booleanParam(
      name: 'RESET_DATABASE',
      defaultValue: false,
      description: 'Restore the approved masked Test database baseline before seeding; destructive and disabled by default.\n'
        + 'framework-proof: Applied before proof data is seeded when selected.\n'
        + 'application-diagnostic: Applied before workload data is seeded when selected.\n'
        + 'performance: Applied before workload data is seeded when selected.'
    )
  ])
])

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar,
  ]
}

def secrets = [
  'appreg-${env}': [
    secret('TEST-USERS-PASSWORD', 'TEST_USERS_PASSWORD'),
    secret('azure-tenant-id', 'TENANT_ID'),
    secret('POSTGRES-USER', 'DB_USER'),
    secret('POSTGRES-PASS', 'DB_PASSWORD'),
    secret('POSTGRES-HOST', 'DB_HOST'),
    secret('POSTGRES-PORT', 'DB_PORT'),
    secret('POSTGRES-DATABASE', 'DB_NAME'),
  ],
]

def dbResetCommand = '''
  echo "Running approved Postgres reload"
  command -v psql
  required_value() {
    name="$1"
    expected="$2"
    actual="$(printenv "$name" || true)"
    if [ "$actual" != "$expected" ]; then
      echo "Refusing database reset: $name must be $expected" >&2
      exit 1
    fi
  }
  required_non_empty() {
    name="$1"
    if [ -z "$(printenv "$name" || true)" ]; then
      echo "Refusing database reset: $name is not set" >&2
      exit 1
    fi
  }
  required_value APPREG_PIPELINE_COMPONENT performance
  required_value APPREG_PIPELINE_ENVIRONMENT test
  required_value TEST_TYPE pipeline
  required_value TEST_URL https://appreg.test.apps.hmcts.net
  required_value RUN_DB_RESET true
  for variable in DB_HOST DB_PORT DB_NAME DB_USER DB_PASSWORD; do
    required_non_empty "$variable"
  done
  case "$DB_HOST" in
    *test*|*Test*|*TEST*) ;;
    *)
      echo "Refusing database reset: DB_HOST must identify the Test database host" >&2
      exit 1
      ;;
  esac
  case "$DB_HOST $DB_NAME" in
    *staging*|*Staging*|*STAGING*|*prod*|*Prod*|*PROD*|*production*|*Production*|*PRODUCTION*)
      echo "Refusing database reset: DB_HOST/DB_NAME must not identify staging or production" >&2
      exit 1
      ;;
  esac
  export PGPASSWORD="$DB_PASSWORD"
  psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" \
    -v ON_ERROR_STOP=1 \
    -v appreg_reset_confirm=APPREG_PERFORMANCE_TEST_RESET \
    -v appreg_reset_pipeline_component="$APPREG_PIPELINE_COMPONENT" \
    -v appreg_reset_environment="$APPREG_PIPELINE_ENVIRONMENT" \
    -v appreg_reset_test_type="$TEST_TYPE" \
    -v appreg_reset_test_url="$TEST_URL" \
    -v appreg_reset_db_host="$DB_HOST" \
    -v appreg_reset_db_name="$DB_NAME" \
    -f db/postgres/reload_data.sql
'''

def dbSeedCommand = '''
  export JAVA_HOME="$(ls -d /usr/lib/jvm/temurin-21-jdk-*)"
  export PATH="$JAVA_HOME/bin:$PATH"
  workload_profile="${WORKLOAD_PROFILE:-smoke}"
  profile_file=data/seed/workload/allocation-profile.properties
  if [ ! -f "$profile_file" ]; then
    echo "Workload allocation profile was not found: $profile_file" >&2
    exit 1
  fi
  profile_value() {
    key="$workload_profile.$1"
    value="$(awk -F= -v key="$key" '$1 == key { print $2; exit }' "$profile_file")"
    if [ -z "$value" ]; then
      echo "Allocation profile $workload_profile is missing $1" >&2
      exit 1
    fi
    printf '%s' "$value"
  }
  if [ "$RUN_PERFTEST" != "true" ] && [ "$workload_profile" != "smoke" ]; then
    echo "WORKLOAD_PROFILE=$workload_profile requires RUN_PERFTEST=true; use smoke for proof-only runs" >&2
    exit 1
  fi
  if [ "$RUN_PERFTEST" = "true" ]; then
    actions_per_user="$(profile_value actions_per_user)"
    concurrent_users="$(profile_value concurrent_users)"
    scheduled_total=0
    for action in update_application update_list add_application result_application result_multiple \
      update_result close_list bulk_officials bulk_fees bulk_upload create_list other_operations; do
      scheduled_count="$(profile_value "scheduled_$action")"
      case "$scheduled_count" in
        ''|*[!0-9]*) echo "Scheduled action counts must be non-negative integers" >&2; exit 1 ;;
      esac
      scheduled_total=$((scheduled_total + scheduled_count))
    done
    expected_total=$((concurrent_users * actions_per_user))
    if [ "$scheduled_total" -ne "$expected_total" ]; then
      echo "Deterministic schedule has $scheduled_total actions; expected $expected_total" >&2
      exit 1
    fi
  fi
  proof_reserve=0
  if [ "$RUN_PERFTEST" = "true" ] && [ "$RUN_PROOF_SMOKES" = "true" ]; then
    proof_reserve=1
  fi
  if [ "$RUN_PERFTEST" = "true" ]; then
    max_users="${MAX_USERS:-100}"
    case "$max_users" in
      ''|*[!0-9]*) echo "MAX_USERS must be a positive integer" >&2; exit 1 ;;
    esac
    if [ "$max_users" -lt 1 ]; then
      echo "MAX_USERS must be a positive integer" >&2
      exit 1
    fi
    if [ "$max_users" -gt 500 ]; then
      echo "MAX_USERS must not exceed 500" >&2
      exit 1
    fi
    run_duration_minutes="${RUN_DURATION_MINUTES:-70}"
    case "$run_duration_minutes" in
      ''|*[!0-9]*) echo "RUN_DURATION_MINUTES must be a positive integer" >&2; exit 1 ;;
    esac
    if [ "$run_duration_minutes" -lt 1 ]; then
      echo "RUN_DURATION_MINUTES must be a positive integer" >&2
      exit 1
    fi
    if [ $((max_users * run_duration_minutes)) -gt 35000 ]; then
      echo "Requested run exceeds the supported workload envelope: MAX_USERS * RUN_DURATION_MINUTES must be <= 35000" >&2
      exit 1
    fi
    workload_plan="$(./gradlew --no-daemon --quiet printWorkloadPlan \
      -DappRegWorkloadProfile="$workload_profile" \
      -DappRegMaxUsers="$max_users" \
      -DappRegDurationMinutes="$run_duration_minutes" \
      -DappRegWorkloadSessionPoolSize="$SESSION_POOL_SIZE" \
      -DappRegWorkloadAuthenticationRatePerSecond="$WORKLOAD_AUTHENTICATION_RATE_PER_SECOND" \
      -DappRegWorkloadAuthenticationSetupTimeoutMinutes="$WORKLOAD_AUTHENTICATION_SETUP_TIMEOUT_MINUTES" \
      -DappRegWorkloadActionPaceSeconds="$WORKLOAD_ACTION_PACE_SECONDS" \
      -DappRegWorkloadActionSpreadSeconds="$WORKLOAD_ACTION_SPREAD_SECONDS" \
      -DappRegWorkloadRampDownGraceSeconds="$WORKLOAD_RAMP_DOWN_GRACE_SECONDS")"
    scheduled_count_for() {
      printf '%s\n' "$workload_plan" | awk -F= -v key="$1" '$1 == key { print $2; exit }'
    }
    allocation_count_for() {
      ramp_count="$(scheduled_count_for "ramp_up_$1")"
      measured_count="$(scheduled_count_for "measured_$1")"
      if [ -z "$ramp_count" ] || [ -z "$measured_count" ]; then
        echo "No deterministic ramp-up or measured count for $1" >&2
        exit 1
      fi
      # Seed both phase allocations in one database pass; they are split into non-overlapping
      # feeder files after generation.
      # Keep one canonical row for a proof or a rounded-zero low-volume action.
      count=$((ramp_count + measured_count + proof_reserve))
      if [ "$count" -lt 1 ]; then count=1; fi
      printf '%s' "$count"
    }
  else
    allocation_count_for() {
      printf '%s' "$(($(profile_value "$1") + proof_reserve))"
    }
  fi
  update_application_count="$(allocation_count_for update_application)"
  update_list_count="$(allocation_count_for update_list)"
  add_application_count="$(allocation_count_for add_application)"
  result_application_count="$(allocation_count_for result_application)"
  result_multiple_count="$(allocation_count_for result_multiple)"
  update_result_count="$(allocation_count_for update_result)"
  close_list_count="$(allocation_count_for close_list)"
  bulk_officials_count="$(allocation_count_for bulk_officials)"
  bulk_fees_count="$(allocation_count_for bulk_fees)"
  bulk_upload_count="$(allocation_count_for bulk_upload)"

  for allocation_count in "$update_application_count" "$update_list_count" "$add_application_count" \
    "$result_application_count" "$result_multiple_count" "$update_result_count" "$close_list_count" \
    "$bulk_officials_count" "$bulk_fees_count" "$bulk_upload_count"; do
    case "$allocation_count" in
      ''|*[!0-9]*) echo "Allocation counts must be positive integers" >&2; exit 1 ;;
    esac
    if [ "$allocation_count" -lt 1 ]; then
      echo "Allocation counts must be positive integers" >&2
      exit 1
    fi
  done

  echo "Creating selective $workload_profile seed shapes for per-action allocations"
  export PGPASSWORD="$DB_PASSWORD"
  mkdir -p build/performance-data

  create_feeder() {
    feeder_file="$1"
    seed_shape="$2"
    allocation_count="$3"
    printf '%s\n' 'application_list_id,application_entry_id,entry_id_one,entry_id_two,entry_id_three' > "build/performance-data/$feeder_file.csv"
    seed_output="$(psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" \
      -A -t -F ',' -v ON_ERROR_STOP=1 -v "seed_shape=$seed_shape" \
      -v "seed_count=$allocation_count" -f data/seed/selective-application-list-shapes.psql)"
    # Sequence-repair SELECTs have one field. Every allocation record has the five feeder fields.
    printf '%s\n' "$seed_output" | awk -F ',' 'NF == 5' >> "build/performance-data/$feeder_file.csv"
  }

  create_feeder update-application update_application "$update_application_count"
  create_feeder update-list update_list "$update_list_count"
  create_feeder add-application add_application "$add_application_count"
  create_feeder result-application result_application "$result_application_count"
  create_feeder result-multiple result_multiple "$result_multiple_count"
  create_feeder update-result update_result "$update_result_count"
  create_feeder close-list close_list "$close_list_count"
  create_feeder bulk-officials bulk_officials "$bulk_officials_count"
  create_feeder bulk-fees bulk_fees "$bulk_fees_count"
  create_feeder bulk-upload bulk_upload "$bulk_upload_count"

  validate_feeder_rows() {
    feeder_file="$1"
    expected_rows="$2"
    feeder_rows=$(($(wc -l < "build/performance-data/$feeder_file.csv") - 1))
    if [ "$feeder_rows" -ne "$expected_rows" ]; then
      echo "Generated feeder $feeder_file.csv has $feeder_rows rows; expected $expected_rows" >&2
      exit 1
    fi
  }
  validate_feeder_rows update-application "$update_application_count"
  validate_feeder_rows update-list "$update_list_count"
  validate_feeder_rows add-application "$add_application_count"
  validate_feeder_rows result-application "$result_application_count"
  validate_feeder_rows result-multiple "$result_multiple_count"
  validate_feeder_rows update-result "$update_result_count"
  validate_feeder_rows close-list "$close_list_count"
  validate_feeder_rows bulk-officials "$bulk_officials_count"
  validate_feeder_rows bulk-fees "$bulk_fees_count"
  validate_feeder_rows bulk-upload "$bulk_upload_count"
  echo "Created workspace-only per-action feeder allocations"
  IFS=, read -r bulk_upload_list_id ignored ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/bulk-upload.csv)
EOF
  IFS=, read -r editable_list_id editable_entry_id ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/update-application.csv)
EOF
  IFS=, read -r update_list_id ignored ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/update-list.csv)
EOF
  IFS=, read -r add_application_list_id ignored ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/add-application.csv)
EOF
  IFS=, read -r single_result_list_id single_result_entry_id ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/result-application.csv)
EOF
  IFS=, read -r bulk_target_list_id ignored bulk_entry_id_1 bulk_entry_id_2 bulk_entry_id_3 <<EOF
$(sed -n '2p' build/performance-data/result-multiple.csv)
EOF
  IFS=, read -r update_result_list_id update_result_entry_id ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/update-result.csv)
EOF
  IFS=, read -r close_ready_list_id close_ready_entry_id ignored ignored ignored <<EOF
$(sed -n '2p' build/performance-data/close-list.csv)
EOF
  IFS=, read -r bulk_officials_list_id ignored bulk_officials_entry_id_1 bulk_officials_entry_id_2 bulk_officials_entry_id_3 <<EOF
$(sed -n '2p' build/performance-data/bulk-officials.csv)
EOF
  IFS=, read -r bulk_fees_list_id ignored bulk_fees_entry_id_1 bulk_fees_entry_id_2 bulk_fees_entry_id_3 <<EOF
$(sed -n '2p' build/performance-data/bulk-fees.csv)
EOF
  if [ -z "$editable_list_id" ] || [ -z "$editable_entry_id" ] \
    || [ -z "$update_list_id" ] \
    || [ -z "$close_ready_list_id" ] || [ -z "$close_ready_entry_id" ] \
    || [ -z "$add_application_list_id" ] || [ -z "$single_result_list_id" ] \
    || [ -z "$single_result_entry_id" ] || [ -z "$bulk_fees_list_id" ] \
    || [ -z "$bulk_fees_entry_id_1" ] || [ -z "$bulk_fees_entry_id_2" ] \
    || [ -z "$bulk_fees_entry_id_3" ] || [ -z "$bulk_officials_list_id" ] \
    || [ -z "$bulk_officials_entry_id_1" ] || [ -z "$bulk_officials_entry_id_2" ] \
    || [ -z "$bulk_officials_entry_id_3" ] || [ -z "$update_result_list_id" ] \
    || [ -z "$update_result_entry_id" ]; then
    echo "Seed allocation did not include all required proof UUIDs" >&2
    exit 1
  fi
  mkdir -p build
  cat > build/seed-allocation.env <<EOF
export APPREG_SEED_BULK_UPLOAD_LIST_ID='$bulk_upload_list_id'
export APPREG_SEED_EDITABLE_LIST_ID='$editable_list_id'
export APPREG_SEED_EDITABLE_ENTRY_ID='$editable_entry_id'
export APPREG_SEED_UPDATE_LIST_ID='$update_list_id'
export APPREG_SEED_CLOSE_READY_LIST_ID='$close_ready_list_id'
export APPREG_SEED_CLOSE_READY_ENTRY_ID='$close_ready_entry_id'
export APPREG_SEED_BULK_TARGET_LIST_ID='$bulk_target_list_id'
export APPREG_SEED_BULK_ENTRY_ID_1='$bulk_entry_id_1'
export APPREG_SEED_BULK_ENTRY_ID_2='$bulk_entry_id_2'
export APPREG_SEED_BULK_ENTRY_ID_3='$bulk_entry_id_3'
export APPREG_SEED_ADD_APPLICATION_LIST_ID='$add_application_list_id'
export APPREG_SEED_SINGLE_RESULT_LIST_ID='$single_result_list_id'
export APPREG_SEED_SINGLE_RESULT_ENTRY_ID='$single_result_entry_id'
export APPREG_SEED_BULK_FEES_LIST_ID='$bulk_fees_list_id'
export APPREG_SEED_BULK_FEES_ENTRY_ID_1='$bulk_fees_entry_id_1'
export APPREG_SEED_BULK_FEES_ENTRY_ID_2='$bulk_fees_entry_id_2'
export APPREG_SEED_BULK_FEES_ENTRY_ID_3='$bulk_fees_entry_id_3'
export APPREG_SEED_BULK_OFFICIALS_LIST_ID='$bulk_officials_list_id'
export APPREG_SEED_BULK_OFFICIALS_ENTRY_ID_1='$bulk_officials_entry_id_1'
export APPREG_SEED_BULK_OFFICIALS_ENTRY_ID_2='$bulk_officials_entry_id_2'
export APPREG_SEED_BULK_OFFICIALS_ENTRY_ID_3='$bulk_officials_entry_id_3'
export APPREG_SEED_UPDATE_RESULT_LIST_ID='$update_result_list_id'
export APPREG_SEED_UPDATE_RESULT_ENTRY_ID='$update_result_entry_id'
EOF
'''


withNightlyPipeline(type, product, component) {
    node {
        stage('Direct Gatling proof') {
            timeout(time: 120, unit: 'MINUTES') {
                checkout scm
                withAzureKeyvault(
                    azureKeyVaultSecrets: secrets['appreg-${env}'],
                    keyVaultURLOverride: testVaultUrl,
                    applicationIDOverride: env.AZURE_CLIENT_ID,
                    applicationSecretOverride: env.AZURE_CLIENT_SECRET
                ) {
                    env.TEST_TYPE = 'pipeline'
                    env.TEST_URL = 'https://appreg.test.apps.hmcts.net'
                    env.APPREG_PIPELINE_COMPONENT = component
                    env.APPREG_PIPELINE_ENVIRONMENT = 'test'
                    env.TEST_USER_EMAIL = initialTestUserEmail
                    env.APPREG_TEST_ACCOUNT_TEMPLATE = 'appreg-{index}@dev.platform.hmcts.net'
                    env.AUTH_MODE = 'sso-login'
                    env.PERFORMANCE_TEST_USERS = '1'
                    def runMode = params.RUN_MODE ?: 'framework-proof'
                    def diagnosticUsers = (params.MAX_USERS ?: '10').toString().trim()
                    def requestedSessionPoolSize = (params.SESSION_POOL_SIZE ?: '').toString().trim()
                    def requestedDurationMinutes = (params.RUN_DURATION_MINUTES ?: '30').toString().trim()
                    def authenticationRateText = (params.AUTHENTICATION_RATE_PER_SECOND ?: '0.15').toString().trim()
                    def actionPaceSeconds = (params.ACTION_PACE_SECONDS ?: '60').toString().trim()
                    def actionSpreadSeconds = (params.ACTION_SPREAD_SECONDS ?: '60').toString().trim()
                    def workloadSetupTimeoutMinutes = (env.WORKLOAD_AUTHENTICATION_SETUP_TIMEOUT_MINUTES ?: '15').toString().trim()
                    def workloadRampDownGraceSeconds = (env.WORKLOAD_RAMP_DOWN_GRACE_SECONDS ?: '60').toString().trim()
                    def workloadGatewayGetRetries = (env.WORKLOAD_GATEWAY_GET_RETRIES ?: '1').toString().trim()
                    def workloadGatewayGetRetryDelaySeconds = (env.WORKLOAD_GATEWAY_GET_RETRY_DELAY_SECONDS ?: '1').toString().trim()
                    def workloadBulkUploadPollTimeoutSeconds = (env.WORKLOAD_BULK_UPLOAD_POLL_TIMEOUT_SECONDS ?: '30').toString().trim()
                    def gatlingConsoleWritePeriodSeconds = (env.GATLING_CONSOLE_WRITE_PERIOD_SECONDS ?: '10').toString().trim()
                    def runModes = [
                        'application-diagnostic': [profile: 'performance', users: diagnosticUsers, minutes: requestedDurationMinutes, proofs: false, workload: true, seed: true],
                        'framework-proof':         [profile: 'smoke', users: '1', minutes: '1', proofs: true, workload: false, seed: true],
                        'performance':             [profile: 'performance', users: '500', minutes: requestedDurationMinutes, proofs: false, workload: true, seed: true]
                    ]
                    def selectedRun = runModes[runMode]
                    if (selectedRun == null) {
                        error "Unsupported RUN_MODE: ${runMode}"
                    }
                    def sessionPoolSize = requestedSessionPoolSize
                    if (!sessionPoolSize) {
                        sessionPoolSize = runMode == 'performance' ? '100' : selectedRun.users
                    }
                    if (selectedRun.workload) {
                        if (runMode == 'application-diagnostic'
                            && (!(diagnosticUsers ==~ /\d+/)
                            || diagnosticUsers.toInteger() < 1
                            || diagnosticUsers.toInteger() > 500)) {
                            error 'application-diagnostic requires MAX_USERS to be an integer from 1 to 500'
                        }
                        if (!(selectedRun.minutes ==~ /\d+/)
                            || selectedRun.minutes.toInteger() < 1
                            || selectedRun.minutes.toInteger() > 70) {
                            error "${runMode} requires RUN_DURATION_MINUTES to be an integer from 1 to 70"
                        }
                        if ((selectedRun.users.toInteger() * selectedRun.minutes.toInteger()) > 35000) {
                            error "${runMode} requires actors multiplied by RUN_DURATION_MINUTES to be 35000 or less"
                        }
                    }
                    if (selectedRun.workload) {
                        if (!(sessionPoolSize ==~ /\d+/)
                            || sessionPoolSize.toInteger() < 1
                            || sessionPoolSize.toInteger() > selectedRun.users.toInteger()) {
                            error "${runMode} requires SESSION_POOL_SIZE to be an integer from 1 to the actor count"
                        }
                        if (!(actionPaceSeconds ==~ /\d+/)
                            || actionPaceSeconds.toInteger() < 60
                            || actionPaceSeconds.toInteger() > 3600) {
                            error 'ACTION_PACE_SECONDS must be an integer from 60 to 3600 seconds'
                        }
                        if (!(actionSpreadSeconds ==~ /\d+/)
                            || actionSpreadSeconds.toInteger() > 3600) {
                            error 'ACTION_SPREAD_SECONDS must be an integer from 0 to 3600 seconds'
                        }
                        double authenticationRatePerSecond
                        try {
                            authenticationRatePerSecond = authenticationRateText.toDouble()
                        } catch (NumberFormatException ignored) {
                            error 'AUTHENTICATION_RATE_PER_SECOND must be greater than 0 and no more than 1'
                        }
                        if (Double.isNaN(value) || Double.isInfinite(value)
                            || authenticationRatePerSecond <= 0
                            || authenticationRatePerSecond > 1) {
                            error 'AUTHENTICATION_RATE_PER_SECOND must be greater than 0 and no more than 1'
                        }
                        if (!(workloadSetupTimeoutMinutes ==~ /\d+/)
                            || workloadSetupTimeoutMinutes.toInteger() < 1
                            || workloadSetupTimeoutMinutes.toInteger() > 1440) {
                            error 'WORKLOAD_AUTHENTICATION_SETUP_TIMEOUT_MINUTES must be from 1 to 1440'
                        }
                        def authenticationRampSeconds = Math.ceil(
                            sessionPoolSize.toInteger() / authenticationRatePerSecond).toInteger()
                        if (authenticationRampSeconds + actionSpreadSeconds.toInteger()
                            >= workloadSetupTimeoutMinutes.toInteger() * 60) {
                            error 'Session authentication at AUTHENTICATION_RATE_PER_SECOND plus actor spread must finish before the setup timeout'
                        }
                    }
                    if (!(gatlingConsoleWritePeriodSeconds ==~ /\d+/)
                        || gatlingConsoleWritePeriodSeconds.toInteger() < 1
                        || gatlingConsoleWritePeriodSeconds.toInteger() > 3600) {
                        error 'GATLING_CONSOLE_WRITE_PERIOD_SECONDS must be from 1 to 3600'
                    }
                    if (selectedRun.workload) {
                        if (!(workloadRampDownGraceSeconds ==~ /\d+/)
                            || workloadRampDownGraceSeconds.toInteger() > 3600) {
                            error 'WORKLOAD_RAMP_DOWN_GRACE_SECONDS must be from 0 to 3600'
                        }
                        if (!(workloadGatewayGetRetries ==~ /\d+/)
                            || workloadGatewayGetRetries.toInteger() > 5) {
                            error 'WORKLOAD_GATEWAY_GET_RETRIES must be from 0 to 5'
                        }
                        if (!(workloadGatewayGetRetryDelaySeconds ==~ /\d+/)
                            || workloadGatewayGetRetryDelaySeconds.toInteger() > 3600) {
                            error 'WORKLOAD_GATEWAY_GET_RETRY_DELAY_SECONDS must be from 0 to 3600'
                        }
                        if (!(workloadBulkUploadPollTimeoutSeconds ==~ /\d+/)
                            || workloadBulkUploadPollTimeoutSeconds.toInteger() < 1
                            || workloadBulkUploadPollTimeoutSeconds.toInteger() > 3600) {
                            error 'WORKLOAD_BULK_UPLOAD_POLL_TIMEOUT_SECONDS must be from 1 to 3600'
                        }
                    }
                    env.RUN_DB_RESET = (selectedRun.seed && (params.RESET_DATABASE ?: false)).toString()
                    env.RUN_DB_SEED = selectedRun.seed.toString()
                    env.RUN_MODE = runMode
                    env.WORKLOAD_PROFILE = selectedRun.profile
                    env.RUN_PROOF_SMOKES = selectedRun.proofs.toString()
                    env.RUN_PERFTEST = selectedRun.workload.toString()
                    env.MAX_USERS = selectedRun.users
                    env.RUN_DURATION_MINUTES = selectedRun.minutes
                    env.SESSION_POOL_SIZE = sessionPoolSize
                    env.WORKLOAD_AUTHENTICATION_RATE_PER_SECOND = authenticationRateText
                    env.WORKLOAD_AUTHENTICATION_SETUP_TIMEOUT_MINUTES = workloadSetupTimeoutMinutes
                    env.WORKLOAD_ACTION_PACE_SECONDS = actionPaceSeconds
                    env.WORKLOAD_ACTION_SPREAD_SECONDS = actionSpreadSeconds
                    env.WORKLOAD_RAMP_DOWN_GRACE_SECONDS = workloadRampDownGraceSeconds
                    env.WORKLOAD_GATEWAY_GET_RETRIES = workloadGatewayGetRetries
                    env.WORKLOAD_GATEWAY_GET_RETRY_DELAY_SECONDS = workloadGatewayGetRetryDelaySeconds
                    env.WORKLOAD_BULK_UPLOAD_POLL_TIMEOUT_SECONDS = workloadBulkUploadPollTimeoutSeconds
                    env.GATLING_CONSOLE_WRITE_PERIOD_SECONDS = gatlingConsoleWritePeriodSeconds
                    if (env.RUN_DB_RESET == 'true') {
                        sh dbResetCommand
                    }

                    if (env.RUN_DB_SEED == 'true') {
                        sh dbSeedCommand
                    }

                    try {
                        sh '''
                            export JAVA_HOME="$(ls -d /usr/lib/jvm/temurin-21-jdk-*)"
                            export PATH="$JAVA_HOME/bin:$PATH"
                            java -version
                            echo "Gatling console write period: $GATLING_CONSOLE_WRITE_PERIOD_SECONDS seconds"

                            rm -f build/reports/gatling/workload-nfr-summary.txt

                            if [ "$RUN_DB_SEED" = "true" ]; then
                              . build/seed-allocation.env
                              echo "Seed allocation is available to Gatling"
                            fi

                            for variable in TEST_USER_EMAIL TEST_USERS_PASSWORD TENANT_ID; do
                              if printenv "$variable" > /dev/null 2>&1; then
                                echo "$variable is set"
                              else
                                echo "$variable is missing"
                              fi
                            done
                            if [ "$RUN_PROOF_SMOKES" = "true" ]; then
                              if [ "$RUN_DB_SEED" != "true" ]; then
                                echo "RUN_PROOF_SMOKES=true requires RUN_DB_SEED=true" >&2
                                exit 1
                              fi

                              # One virtual user reuses one SSO session across the complete seeded proof set.
                              ./gradlew --no-daemon gatlingRun \
                                -Dgatling.data.console.writePeriod="$GATLING_CONSOLE_WRITE_PERIOD_SECONDS" \
                                --simulation simulations.FrameworkProofSimulation
                            fi

                            if [ "$RUN_PERFTEST" = "true" ]; then
                              if [ "$RUN_DB_SEED" != "true" ]; then
                                echo "RUN_PERFTEST=true requires RUN_DB_SEED=true" >&2
                                exit 1
                              fi
                              if [ "$WORKLOAD_PROFILE" = "smoke" ]; then
                                echo "RUN_PERFTEST=true requires WORKLOAD_PROFILE=validation or performance" >&2
                                exit 1
                              fi

                              mkdir -p build/workload-data/ramp-up build/workload-data/measured
                              workload_plan="$(./gradlew --no-daemon --quiet printWorkloadPlan \
                                -DappRegWorkloadProfile="$WORKLOAD_PROFILE" \
                                -DappRegMaxUsers="$MAX_USERS" \
                                -DappRegDurationMinutes="$RUN_DURATION_MINUTES" \
                                -DappRegWorkloadSessionPoolSize="$SESSION_POOL_SIZE" \
                                -DappRegWorkloadAuthenticationRatePerSecond="$WORKLOAD_AUTHENTICATION_RATE_PER_SECOND" \
                                -DappRegWorkloadAuthenticationSetupTimeoutMinutes="$WORKLOAD_AUTHENTICATION_SETUP_TIMEOUT_MINUTES" \
                                -DappRegWorkloadActionPaceSeconds="$WORKLOAD_ACTION_PACE_SECONDS" \
                                -DappRegWorkloadActionSpreadSeconds="$WORKLOAD_ACTION_SPREAD_SECONDS" \
                                -DappRegWorkloadRampDownGraceSeconds="$WORKLOAD_RAMP_DOWN_GRACE_SECONDS")"
                              scheduled_count_for() {
                                printf '%s\n' "$workload_plan" | awk -F= -v key="$1" '$1 == key { print $2; exit }'
                              }
                              for feeder in update-application update-list add-application result-application \
                                result-multiple update-result close-list bulk-officials bulk-fees bulk-upload; do
                                action_key="$(printf '%s' "$feeder" | tr '-' '_')"
                                ramp_count="$(scheduled_count_for "ramp_up_$action_key")"
                                measured_count="$(scheduled_count_for "measured_$action_key")"
                                if [ -z "$ramp_count" ] || [ -z "$measured_count" ]; then
                                  echo "No deterministic ramp-up or measured count for $action_key" >&2
                                  exit 1
                                fi
                                data_start_row=2
                                if [ "$RUN_PROOF_SMOKES" = "true" ]; then data_start_row=3; fi
                                # Row 1 is the CSV header and an optional proof row comes next. The
                                # measured slice begins immediately after the ramp-up slice, which is
                                # the isolation guarantee for mutable test data.
                                awk -F, -v start="$data_start_row" -v count="$ramp_count" \
                                  'NR == 1 || (NR >= start && NR < start + count)' \
                                  "build/performance-data/$feeder.csv" > "build/workload-data/ramp-up/$feeder.csv"
                                measured_start_row=$((data_start_row + ramp_count))
                                awk -F, -v start="$measured_start_row" -v count="$measured_count" \
                                  'NR == 1 || (NR >= start && NR < start + count)' \
                                  "build/performance-data/$feeder.csv" > "build/workload-data/measured/$feeder.csv"
                                generated_ramp_count=$(($(wc -l < "build/workload-data/ramp-up/$feeder.csv") - 1))
                                generated_measured_count=$(($(wc -l < "build/workload-data/measured/$feeder.csv") - 1))
                                if [ "$generated_ramp_count" -ne "$ramp_count" ]; then
                                  echo "Ramp-up feeder $feeder has $generated_ramp_count rows; expected $ramp_count" >&2
                                  exit 1
                                fi
                                if [ "$generated_measured_count" -ne "$measured_count" ]; then
                                  echo "Measured feeder $feeder has $generated_measured_count rows; expected $measured_count" >&2
                                  exit 1
                                fi
                              done

                              ./gradlew --no-daemon gatlingRun \
                                -Dgatling.data.console.writePeriod="$GATLING_CONSOLE_WRITE_PERIOD_SECONDS" \
                                -DappRegWorkloadProfile="$WORKLOAD_PROFILE" \
                                -DappRegMaxUsers="$MAX_USERS" \
                                -DappRegDurationMinutes="$RUN_DURATION_MINUTES" \
                                -DappRegWorkloadSessionPoolSize="$SESSION_POOL_SIZE" \
                                -DappRegWorkloadAuthenticationRatePerSecond="$WORKLOAD_AUTHENTICATION_RATE_PER_SECOND" \
                                -DappRegWorkloadAuthenticationSetupTimeoutMinutes="$WORKLOAD_AUTHENTICATION_SETUP_TIMEOUT_MINUTES" \
                                -DappRegWorkloadActionPaceSeconds="$WORKLOAD_ACTION_PACE_SECONDS" \
                                -DappRegWorkloadActionSpreadSeconds="$WORKLOAD_ACTION_SPREAD_SECONDS" \
                                -DappRegWorkloadRampDownGraceSeconds="$WORKLOAD_RAMP_DOWN_GRACE_SECONDS" \
                                -DappRegGatewayGetRetries="$WORKLOAD_GATEWAY_GET_RETRIES" \
                                -DappRegGatewayGetRetryDelaySeconds="$WORKLOAD_GATEWAY_GET_RETRY_DELAY_SECONDS" \
                                -DappRegBulkUploadPollTimeoutSeconds="$WORKLOAD_BULK_UPLOAD_POLL_TIMEOUT_SECONDS" \
                                -DappRegPerformanceDataDirectory="$PWD/build/workload-data" \
                                --simulation simulations.AppRegWorkloadSimulation
                            fi
                        '''
                    } finally {
                        publishGatlingReports()
                    }
                }
            }
        }
    }

    afterAlways('DependencyCheckNightly') {
        archiveDependencyCheckReport()
    }
}

def publishGatlingReports() {
    def reportsDirectory = 'build/reports/gatling'
    def nfrSummaryPath = "${reportsDirectory}/workload-nfr-summary.txt"

    if (env.RUN_PERFTEST == 'true' && !fileExists(nfrSummaryPath)) {
        sh "mkdir -p ${reportsDirectory}"
        writeFile(
            file: nfrSummaryPath,
            text: '''========== WORKLOAD NFR SUMMARY ==========
Result classification: FRAMEWORK_OR_SETUP_FAILURE
No complete workload summary was produced; inspect the console log for the setup or framework failure.
Overall asserted workload-operation verdict: FAIL
==========================================
'''
        )
    }

    if (!fileExists(reportsDirectory)) {
        echo "No Gatling reports found in ${reportsDirectory}; nothing to publish."
        return
    }

    def reportIndexes = findFiles(glob: "${reportsDirectory}/*/index.html")
    def reportLinks = reportIndexes.collect { report ->
        def relativePath = report.path.substring(reportsDirectory.length() + 1)
        def reportDirectory = relativePath.substring(0, relativePath.lastIndexOf('/'))
        [path: relativePath, name: reportDirectory]
    }
    def publishedReportLinks = reportLinks.collect { report ->
        "<li><a href=\"${report.path}\">${report.name}</a></li>"
    }.join('\n')
    def archivedReportLinks = reportLinks.collect { report ->
        "<li><a href=\"${reportsDirectory}/${report.path}\">${report.name}</a></li>"
    }.join('\n')
    if (fileExists(nfrSummaryPath)) {
        publishedReportLinks = "<li><a href=\"workload-nfr-summary.txt\">Workload NFR summary</a></li>\n${publishedReportLinks}"
        archivedReportLinks = "<li><a href=\"${nfrSummaryPath}\">Workload NFR summary</a></li>\n${archivedReportLinks}"
    }

    writeFile(
        file: "${reportsDirectory}/index.html",
        text: """<!doctype html>
<html lang=\"en\">
  <head><meta charset=\"utf-8\"><title>Gatling Performance Reports</title></head>
  <body>
    <h1>Gatling Performance Reports</h1>
    <ul>${publishedReportLinks ?: '<li>No Gatling report was generated.</li>'}</ul>
  </body>
</html>
"""
    )
    writeFile(
        file: 'gatling-performance-reports.html',
        text: """<!doctype html>
<html lang=\"en\">
  <head><meta charset=\"utf-8\"><title>Gatling Performance Reports</title></head>
  <body>
    <h1>Gatling Performance Reports</h1>
    <ul>${archivedReportLinks ?: '<li>No Gatling report was generated.</li>'}</ul>
  </body>
</html>
"""
    )

    archiveArtifacts allowEmptyArchive: true, artifacts: "${reportsDirectory}/**/*"
    archiveArtifacts allowEmptyArchive: true, artifacts: 'gatling-performance-reports.html'
    publishHTML target: [
        allowMissing: true,
        alwaysLinkToLastBuild: true,
        keepAll: true,
        reportDir: reportsDirectory,
        reportFiles: 'index.html',
        reportName: 'Gatling Performance Reports'
    ]
}

def archiveDependencyCheckReport() {
  def dependencyCheckReportCandidates = [
    'build/reports/dependency-check/dependency-check-report.html',
    'build/reports/dependency-check-report.html'
  ]
  def dependencyCheckReport = dependencyCheckReportCandidates.find { fileExists(it) }

  if (!dependencyCheckReport) {
    echo "No Dependency-Check report found in expected locations: ${dependencyCheckReportCandidates.join(', ')}; nothing to archive."
        return
    }

    writeFile file: 'dependency-check-report.html', text: readFile(dependencyCheckReport)
    archiveArtifacts allowEmptyArchive: true, artifacts: 'dependency-check-report.html'
}