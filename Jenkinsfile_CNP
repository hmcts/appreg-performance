@Library("Infrastructure") _

def product = "appreg"
def type = "java"
def component = "performance"

def vaultOverrides = [
  'dev': 'stg',
  'preview': 'stg',
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar,
  ]
}

def secrets = [
  'appreg-${env}': [
    secret('TEST-USER-EMAIL', 'TEST_USER_EMAIL'),
    secret('TEST-USERS-PASSWORD', 'TEST_USERS_PASSWORD'),
    secret('azure-tenant-id', 'TENANT_ID'),
    secret('azure-app-id', 'CLIENT_ID'),
    secret('azure-client-secret', 'CLIENT_SECRET'),
    secret('azure-scope', 'SCOPE'),
  ],
]


withNightlyPipeline(type, product, component) {
    node {
        stage('Direct Gatling proof') {
            timeout(time: 90, unit: 'MINUTES') {
                checkout scm
                overrideVaultEnvironments(vaultOverrides)
                loadVaultSecrets(secrets)

                env.TEST_TYPE = 'pipeline'
                env.TEST_URL = 'https://appreg.staging.apps.hmcts.net'
                env.AUTH_MODE = 'sso-login'
                env.PERFORMANCE_TEST_USERS = '1'

                sh '''
                    for variable in TEST_USER_EMAIL TEST_USERS_PASSWORD TENANT_ID CLIENT_ID CLIENT_SECRET SCOPE; do
                      if printenv "$variable" > /dev/null 2>&1; then
                        echo "$variable is set"
                      else
                        echo "$variable is missing"
                      fi
                    done
                    ./gradlew --no-daemon gatlingRun
                '''
            }
        }
    }
}
