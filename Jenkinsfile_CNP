@Library("Infrastructure") _

def product = "appreg"
def type = "java"
def component = "performance"

def testVaultUrl = 'https://appreg-kv-test.vault.azure.net/'
def initialTestUserEmail = 'appreg-001@dev.platform.hmcts.net'

properties([
  parameters([
    booleanParam(
      name: 'RUN_DB_RESET',
      defaultValue: false,
      description: 'Restore the approved masked Test database baseline before Gatling'
    ),
    booleanParam(
      name: 'RUN_DB_SEED',
      defaultValue: true,
      description: 'Create and capture canonical Gatling seed data before Gatling'
    ),
    string(
      name: 'UPDATE_APPLICATION_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated rows for Update Application; one is sufficient for proof smoke'
    ),
    string(
      name: 'ADD_APPLICATION_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated rows for Add Application; one is sufficient for proof smoke'
    ),
    string(
      name: 'RESULT_APPLICATION_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated rows for Result Application; one is sufficient for proof smoke'
    ),
    string(
      name: 'RESULT_MULTIPLE_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated three-entry rows for Result Multiple Applications; one is sufficient for proof smoke'
    ),
    string(
      name: 'UPDATE_RESULT_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated rows for Update Result Application; one is sufficient for proof smoke'
    ),
    string(
      name: 'CLOSE_LIST_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated close-ready rows for Close Application List; one is sufficient for proof smoke'
    ),
    string(
      name: 'BULK_OFFICIALS_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated three-entry rows for Bulk Update Officials; one is sufficient for proof smoke'
    ),
    string(
      name: 'BULK_FEES_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated three-entry rows for Bulk Update Fees; one is sufficient for proof smoke'
    ),
    string(
      name: 'BULK_UPLOAD_ALLOCATION_COUNT',
      defaultValue: '1',
      description: 'Allocated rows for Bulk Application Upload; one is sufficient for proof smoke'
    ),
    booleanParam(
      name: 'RUN_PROOF_SMOKES',
      defaultValue: true,
      description: 'Run every one-user proof against fresh seed allocations'
    ),
    booleanParam(
      name: 'RUN_PERFTEST',
      defaultValue: false,
      description: 'Reserved for the weighted multi-user workload; do not enable until scaled feeders are implemented'
    )
  ])
])

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar,
  ]
}

def secrets = [
  'appreg-${env}': [
    secret('TEST-USERS-PASSWORD', 'TEST_USERS_PASSWORD'),
    secret('azure-tenant-id', 'TENANT_ID'),
    secret('POSTGRES-USER', 'DB_USER'),
    secret('POSTGRES-PASS', 'DB_PASSWORD'),
    secret('POSTGRES-HOST', 'DB_HOST'),
    secret('POSTGRES-PORT', 'DB_PORT'),
    secret('POSTGRES-DATABASE', 'DB_NAME'),
  ],
]

def dbResetCommand = params.RUN_DB_RESET ? '''
  echo "Running approved Postgres reload"
  command -v psql
  export PGPASSWORD="$DB_PASSWORD"
  psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" \
    -v ON_ERROR_STOP=1 -f db/postgres/reload_data.sql
''' : ''

def dbSeedCommand = params.RUN_DB_SEED ? '''
  update_application_count="${UPDATE_APPLICATION_ALLOCATION_COUNT:-1}"
  add_application_count="${ADD_APPLICATION_ALLOCATION_COUNT:-1}"
  result_application_count="${RESULT_APPLICATION_ALLOCATION_COUNT:-1}"
  result_multiple_count="${RESULT_MULTIPLE_ALLOCATION_COUNT:-1}"
  update_result_count="${UPDATE_RESULT_ALLOCATION_COUNT:-1}"
  close_list_count="${CLOSE_LIST_ALLOCATION_COUNT:-1}"
  bulk_officials_count="${BULK_OFFICIALS_ALLOCATION_COUNT:-1}"
  bulk_fees_count="${BULK_FEES_ALLOCATION_COUNT:-1}"
  bulk_upload_count="${BULK_UPLOAD_ALLOCATION_COUNT:-1}"

  for allocation_count in "$update_application_count" "$add_application_count" "$result_application_count" \
    "$result_multiple_count" "$update_result_count" "$close_list_count" "$bulk_officials_count" \
    "$bulk_fees_count" "$bulk_upload_count"; do
    case "$allocation_count" in
      ''|*[!0-9]*) echo "Allocation counts must be positive integers" >&2; exit 1 ;;
    esac
    if [ "$allocation_count" -lt 1 ]; then
      echo "Allocation counts must be positive integers" >&2
      exit 1
    fi
  done

  canonical_seed_count=1
  for allocation_count in "$update_application_count" "$add_application_count" "$result_application_count" \
    "$result_multiple_count" "$update_result_count" "$close_list_count" "$bulk_officials_count" \
    "$bulk_fees_count" "$bulk_upload_count"; do
    if [ "$allocation_count" -gt "$canonical_seed_count" ]; then
      canonical_seed_count="$allocation_count"
    fi
  done

  echo "Creating $canonical_seed_count canonical seed row(s) for per-action allocations"
  export PGPASSWORD="$DB_PASSWORD"
  mkdir -p build/performance-data
  printf '%s\n' 'application_list_id,application_entry_id' > build/performance-data/update-application.csv
  printf '%s\n' 'application_list_id' > build/performance-data/add-application.csv
  printf '%s\n' 'application_list_id,application_entry_id' > build/performance-data/result-application.csv
  printf '%s\n' 'application_list_id,entry_id_one,entry_id_two,entry_id_three' > build/performance-data/result-multiple.csv
  printf '%s\n' 'application_list_id,application_entry_id' > build/performance-data/update-result.csv
  printf '%s\n' 'application_list_id,application_entry_id' > build/performance-data/close-list.csv
  printf '%s\n' 'application_list_id,entry_id_one,entry_id_two,entry_id_three' > build/performance-data/bulk-officials.csv
  printf '%s\n' 'application_list_id,entry_id_one,entry_id_two,entry_id_three' > build/performance-data/bulk-fees.csv
  printf '%s\n' 'application_list_id' > build/performance-data/bulk-upload.csv

  seed_allocation=''
  allocation_index=1
  while [ "$allocation_index" -le "$canonical_seed_count" ]; do
    seed_output="$(psql -h "$DB_HOST" -p "$DB_PORT" -d "$DB_NAME" -U "$DB_USER" \
      -A -t -F '|' -v ON_ERROR_STOP=1 -f data/seed/canonical-application-list-shapes.psql)"
    allocation_row="$(printf '%s\n' "$seed_output" | tail -n 1)"
    if [ -z "$allocation_row" ]; then
      echo "Seed allocation $allocation_index was empty" >&2
      exit 1
    fi
    if [ "$allocation_index" -le "$update_application_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 2,3 | tr '|' ',' >> build/performance-data/update-application.csv
    fi
    if [ "$allocation_index" -le "$add_application_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 10 >> build/performance-data/add-application.csv
    fi
    if [ "$allocation_index" -le "$result_application_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 11,12 | tr '|' ',' >> build/performance-data/result-application.csv
    fi
    if [ "$allocation_index" -le "$result_multiple_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 6,7,8,9 | tr '|' ',' >> build/performance-data/result-multiple.csv
    fi
    if [ "$allocation_index" -le "$update_result_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 21,22 | tr '|' ',' >> build/performance-data/update-result.csv
    fi
    if [ "$allocation_index" -le "$close_list_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 4,5 | tr '|' ',' >> build/performance-data/close-list.csv
    fi
    if [ "$allocation_index" -le "$bulk_officials_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 17,18,19,20 | tr '|' ',' >> build/performance-data/bulk-officials.csv
    fi
    if [ "$allocation_index" -le "$bulk_fees_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 13,14,15,16 | tr '|' ',' >> build/performance-data/bulk-fees.csv
    fi
    if [ "$allocation_index" -le "$bulk_upload_count" ]; then
      printf '%s\n' "$allocation_row" | cut -d '|' -f 1 >> build/performance-data/bulk-upload.csv
    fi
    if [ "$allocation_index" -eq 1 ]; then
      seed_allocation="$allocation_row"
    fi
    allocation_index=$((allocation_index + 1))
  done

  validate_feeder_rows() {
    feeder_file="$1"
    expected_rows="$2"
    feeder_rows=$(($(wc -l < "build/performance-data/$feeder_file.csv") - 1))
    if [ "$feeder_rows" -ne "$expected_rows" ]; then
      echo "Generated feeder $feeder_file.csv has $feeder_rows rows; expected $expected_rows" >&2
      exit 1
    fi
  }
  validate_feeder_rows update-application "$update_application_count"
  validate_feeder_rows add-application "$add_application_count"
  validate_feeder_rows result-application "$result_application_count"
  validate_feeder_rows result-multiple "$result_multiple_count"
  validate_feeder_rows update-result "$update_result_count"
  validate_feeder_rows close-list "$close_list_count"
  validate_feeder_rows bulk-officials "$bulk_officials_count"
  validate_feeder_rows bulk-fees "$bulk_fees_count"
  validate_feeder_rows bulk-upload "$bulk_upload_count"
  echo "Created workspace-only per-action feeder allocations"
  IFS='|' read -r bulk_upload_list_id editable_list_id editable_entry_id \
    close_ready_list_id close_ready_entry_id bulk_target_list_id \
    bulk_entry_id_1 bulk_entry_id_2 bulk_entry_id_3 add_application_list_id \
    single_result_list_id single_result_entry_id bulk_fees_list_id \
    bulk_fees_entry_id_1 bulk_fees_entry_id_2 bulk_fees_entry_id_3 \
    bulk_officials_list_id bulk_officials_entry_id_1 \
    bulk_officials_entry_id_2 bulk_officials_entry_id_3 \
    update_result_list_id update_result_entry_id <<EOF
$seed_allocation
EOF
  if [ -z "$editable_list_id" ] || [ -z "$editable_entry_id" ] \
    || [ -z "$close_ready_list_id" ] || [ -z "$close_ready_entry_id" ] \
    || [ -z "$add_application_list_id" ] || [ -z "$single_result_list_id" ] \
    || [ -z "$single_result_entry_id" ] || [ -z "$bulk_fees_list_id" ] \
    || [ -z "$bulk_fees_entry_id_1" ] || [ -z "$bulk_fees_entry_id_2" ] \
    || [ -z "$bulk_fees_entry_id_3" ] || [ -z "$bulk_officials_list_id" ] \
    || [ -z "$bulk_officials_entry_id_1" ] || [ -z "$bulk_officials_entry_id_2" ] \
    || [ -z "$bulk_officials_entry_id_3" ] || [ -z "$update_result_list_id" ] \
    || [ -z "$update_result_entry_id" ]; then
    echo "Seed allocation did not include all required proof UUIDs" >&2
    exit 1
  fi
  mkdir -p build
  cat > build/seed-allocation.env <<EOF
export APPREG_SEED_BULK_UPLOAD_LIST_ID='$bulk_upload_list_id'
export APPREG_SEED_EDITABLE_LIST_ID='$editable_list_id'
export APPREG_SEED_EDITABLE_ENTRY_ID='$editable_entry_id'
export APPREG_SEED_CLOSE_READY_LIST_ID='$close_ready_list_id'
export APPREG_SEED_CLOSE_READY_ENTRY_ID='$close_ready_entry_id'
export APPREG_SEED_BULK_TARGET_LIST_ID='$bulk_target_list_id'
export APPREG_SEED_BULK_ENTRY_ID_1='$bulk_entry_id_1'
export APPREG_SEED_BULK_ENTRY_ID_2='$bulk_entry_id_2'
export APPREG_SEED_BULK_ENTRY_ID_3='$bulk_entry_id_3'
export APPREG_SEED_ADD_APPLICATION_LIST_ID='$add_application_list_id'
export APPREG_SEED_SINGLE_RESULT_LIST_ID='$single_result_list_id'
export APPREG_SEED_SINGLE_RESULT_ENTRY_ID='$single_result_entry_id'
export APPREG_SEED_BULK_FEES_LIST_ID='$bulk_fees_list_id'
export APPREG_SEED_BULK_FEES_ENTRY_ID_1='$bulk_fees_entry_id_1'
export APPREG_SEED_BULK_FEES_ENTRY_ID_2='$bulk_fees_entry_id_2'
export APPREG_SEED_BULK_FEES_ENTRY_ID_3='$bulk_fees_entry_id_3'
export APPREG_SEED_BULK_OFFICIALS_LIST_ID='$bulk_officials_list_id'
export APPREG_SEED_BULK_OFFICIALS_ENTRY_ID_1='$bulk_officials_entry_id_1'
export APPREG_SEED_BULK_OFFICIALS_ENTRY_ID_2='$bulk_officials_entry_id_2'
export APPREG_SEED_BULK_OFFICIALS_ENTRY_ID_3='$bulk_officials_entry_id_3'
export APPREG_SEED_UPDATE_RESULT_LIST_ID='$update_result_list_id'
export APPREG_SEED_UPDATE_RESULT_ENTRY_ID='$update_result_entry_id'
EOF
''' : ''


withNightlyPipeline(type, product, component) {
    node {
        stage('Direct Gatling proof') {
            timeout(time: 90, unit: 'MINUTES') {
                checkout scm
                withAzureKeyvault(
                    azureKeyVaultSecrets: secrets['appreg-${env}'],
                    keyVaultURLOverride: testVaultUrl,
                    applicationIDOverride: env.AZURE_CLIENT_ID,
                    applicationSecretOverride: env.AZURE_CLIENT_SECRET
                ) {
                    env.TEST_TYPE = 'pipeline'
                    env.TEST_URL = 'https://appreg.test.apps.hmcts.net'
                    env.TEST_USER_EMAIL = initialTestUserEmail
                    env.AUTH_MODE = 'sso-login'
                    env.PERFORMANCE_TEST_USERS = '1'
                    env.RUN_DB_RESET = params.RUN_DB_RESET.toString()
                    env.RUN_DB_SEED = params.RUN_DB_SEED.toString()
                    env.UPDATE_APPLICATION_ALLOCATION_COUNT = params.UPDATE_APPLICATION_ALLOCATION_COUNT
                    env.ADD_APPLICATION_ALLOCATION_COUNT = params.ADD_APPLICATION_ALLOCATION_COUNT
                    env.RESULT_APPLICATION_ALLOCATION_COUNT = params.RESULT_APPLICATION_ALLOCATION_COUNT
                    env.RESULT_MULTIPLE_ALLOCATION_COUNT = params.RESULT_MULTIPLE_ALLOCATION_COUNT
                    env.UPDATE_RESULT_ALLOCATION_COUNT = params.UPDATE_RESULT_ALLOCATION_COUNT
                    env.CLOSE_LIST_ALLOCATION_COUNT = params.CLOSE_LIST_ALLOCATION_COUNT
                    env.BULK_OFFICIALS_ALLOCATION_COUNT = params.BULK_OFFICIALS_ALLOCATION_COUNT
                    env.BULK_FEES_ALLOCATION_COUNT = params.BULK_FEES_ALLOCATION_COUNT
                    env.BULK_UPLOAD_ALLOCATION_COUNT = params.BULK_UPLOAD_ALLOCATION_COUNT
                    env.RUN_PROOF_SMOKES = params.RUN_PROOF_SMOKES.toString()
                    env.RUN_PERFTEST = params.RUN_PERFTEST.toString()

                    if (params.RUN_DB_RESET) {
                        sh dbResetCommand
                    }

                    if (params.RUN_DB_SEED) {
                        sh dbSeedCommand
                    }

                    try {
                        sh '''
                            export JAVA_HOME="$(ls -d /usr/lib/jvm/temurin-21-jdk-*)"
                            export PATH="$JAVA_HOME/bin:$PATH"
                            java -version

                            if [ "$RUN_DB_SEED" = "true" ]; then
                              . build/seed-allocation.env
                              echo "Seed allocation is available to Gatling"
                            fi

                            for variable in TEST_USER_EMAIL TEST_USERS_PASSWORD TENANT_ID; do
                              if printenv "$variable" > /dev/null 2>&1; then
                                echo "$variable is set"
                              else
                                echo "$variable is missing"
                              fi
                            done
                            if [ "$RUN_PROOF_SMOKES" = "true" ]; then
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.AppRegSimulation
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.ActivityAuditReportProofSimulation

                              if [ "$RUN_DB_SEED" != "true" ]; then
                                echo "RUN_PROOF_SMOKES=true requires RUN_DB_SEED=true" >&2
                                exit 1
                              fi

                              # Requires the canonical editable list and entry allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.UpdateApplicationProofSimulation
                              # Requires the separate close-ready list and entry allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.UpdateAndCloseApplicationListProofSimulation
                              # Requires the dedicated empty list allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.AddApplicationProofSimulation
                              # Requires the dedicated three-entry bulk target allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.ResultMultipleApplicationsProofSimulation
                              # Requires the dedicated single-result list and entry allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.ResultApplicationProofSimulation
                              # Requires the dedicated empty bulk-upload list allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.BulkApplicationUploadProofSimulation
                              # Requires the dedicated three-entry bulk-fees allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.BulkUpdateFeesProofSimulation
                              # Requires the dedicated three-entry bulk-officials allocation created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.BulkUpdateOfficialsProofSimulation
                              # Requires the dedicated Application with an existing result created by RUN_DB_SEED.
                              ./gradlew --no-daemon gatlingRun \
                                --simulation simulations.UpdateApplicationResultProofSimulation
                            fi

                            if [ "$RUN_PERFTEST" = "true" ]; then
                              echo "RUN_PERFTEST is not available until ARCPOC-1633 has generated scaled feeder allocations" >&2
                              exit 1
                            fi
                        '''
                    } finally {
                        publishGatlingReports()
                    }
                }
            }
        }
    }

    afterAlways('DependencyCheckNightly') {
        archiveDependencyCheckReport()
    }
}

def publishGatlingReports() {
    def reportsDirectory = 'build/reports/gatling'

    if (!fileExists(reportsDirectory)) {
        echo "No Gatling reports found in ${reportsDirectory}; nothing to publish."
        return
    }

    def reportIndexes = findFiles(glob: "${reportsDirectory}/*/index.html")
    def reportLinks = reportIndexes.collect { report ->
        def relativePath = report.path.substring(reportsDirectory.length() + 1)
        def reportDirectory = relativePath.substring(0, relativePath.lastIndexOf('/'))
        [path: relativePath, name: reportDirectory]
    }
    def publishedReportLinks = reportLinks.collect { report ->
        "<li><a href=\"${report.path}\">${report.name}</a></li>"
    }.join('\n')
    def archivedReportLinks = reportLinks.collect { report ->
        "<li><a href=\"${reportsDirectory}/${report.path}\">${report.name}</a></li>"
    }.join('\n')

    writeFile(
        file: "${reportsDirectory}/index.html",
        text: """<!doctype html>
<html lang=\"en\">
  <head><meta charset=\"utf-8\"><title>Gatling Performance Reports</title></head>
  <body>
    <h1>Gatling Performance Reports</h1>
    <ul>${publishedReportLinks ?: '<li>No Gatling report was generated.</li>'}</ul>
  </body>
</html>
"""
    )
    writeFile(
        file: 'gatling-performance-reports.html',
        text: """<!doctype html>
<html lang=\"en\">
  <head><meta charset=\"utf-8\"><title>Gatling Performance Reports</title></head>
  <body>
    <h1>Gatling Performance Reports</h1>
    <ul>${archivedReportLinks ?: '<li>No Gatling report was generated.</li>'}</ul>
  </body>
</html>
"""
    )

    archiveArtifacts allowEmptyArchive: true, artifacts: "${reportsDirectory}/**/*"
    archiveArtifacts allowEmptyArchive: true, artifacts: 'gatling-performance-reports.html'
    publishHTML target: [
        allowMissing: true,
        alwaysLinkToLastBuild: true,
        keepAll: true,
        reportDir: reportsDirectory,
        reportFiles: 'index.html',
        reportName: 'Gatling Performance Reports'
    ]
}

def archiveDependencyCheckReport() {
  def dependencyCheckReportCandidates = [
    'build/reports/dependency-check/dependency-check-report.html',
    'build/reports/dependency-check-report.html'
  ]
  def dependencyCheckReport = dependencyCheckReportCandidates.find { fileExists(it) }

  if (!dependencyCheckReport) {
    echo "No Dependency-Check report found in expected locations: ${dependencyCheckReportCandidates.join(', ')}; nothing to archive."
        return
    }

    writeFile file: 'dependency-check-report.html', text: readFile(dependencyCheckReport)
    archiveArtifacts allowEmptyArchive: true, artifacts: 'dependency-check-report.html'
}
