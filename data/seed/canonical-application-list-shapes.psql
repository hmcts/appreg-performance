) VALUES (
  nextval('appreg.ale_seq'), :close_ready_list_al_id, NULL, 8, :close_ready_applicant_id,
  :close_ready_respondent_id, NULL,
  'Notice of appeal to the High Court by way of case stated in respect of case heard on {TEXT|10/08/2026|10}',
  NULL, NULL, 'N', NULL, 1, 'Performance.Test', CURRENT_TIMESTAMP, NULL,
  'Performance.Test', 1, NULL, NULL, NULL, CURRENT_DATE::timestamp,
  gen_random_uuid(), NULL, NULL
) RETURNING ale_id AS close_ready_entry_ale_id, id AS close_ready_entry_id
\gset

INSERT INTO appreg.al_ale_sequence_mapping (al_id, ale_last_sequence)
VALUES (:close_ready_list_al_id, 1);

INSERT INTO appreg.app_list_entry_fee_id (
  ale_ale_id, fee_fee_id, version, changed_by, changed_date, user_name
) VALUES (:close_ready_entry_ale_id, 236, 1, 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test');

INSERT INTO appreg.app_list_entry_official (
  aleo_id, ale_ale_id, title, forename, surname, official_type, changed_by, changed_date, user_name
) VALUES
  (nextval('appreg.aleo_seq'), :close_ready_entry_ale_id, 'MR', 'CLOSE', 'MAGISTRATE', 'M', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :close_ready_entry_ale_id, 'MR', 'CLOSE', 'CLERK', 'C', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test');

