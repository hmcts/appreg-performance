  tcep_status, message_uuid, retry_count, lodgement_date, id, delete_by, delete_date
) VALUES
  (nextval('appreg.ale_seq'), :bulk_target_list_al_id, NULL, 8, :bulk_applicant_id_1, :bulk_respondent_id_1, NULL, 'Notice of appeal to the High Court by way of case stated in respect of case heard on {TEXT|10/08/2026|10}', NULL, NULL, 'N', NULL, 1, 'Performance.Test', CURRENT_TIMESTAMP, NULL, 'Performance.Test', 1, NULL, NULL, NULL, CURRENT_DATE::timestamp, gen_random_uuid(), NULL, NULL),
  (nextval('appreg.ale_seq'), :bulk_target_list_al_id, NULL, 8, :bulk_applicant_id_2, :bulk_respondent_id_2, NULL, 'Notice of appeal to the High Court by way of case stated in respect of case heard on {TEXT|10/08/2026|10}', NULL, NULL, 'N', NULL, 1, 'Performance.Test', CURRENT_TIMESTAMP, NULL, 'Performance.Test', 2, NULL, NULL, NULL, CURRENT_DATE::timestamp, gen_random_uuid(), NULL, NULL),
  (nextval('appreg.ale_seq'), :bulk_target_list_al_id, NULL, 8, :bulk_applicant_id_3, :bulk_respondent_id_3, NULL, 'Notice of appeal to the High Court by way of case stated in respect of case heard on {TEXT|10/08/2026|10}', NULL, NULL, 'N', NULL, 1, 'Performance.Test', CURRENT_TIMESTAMP, NULL, 'Performance.Test', 3, NULL, NULL, NULL, CURRENT_DATE::timestamp, gen_random_uuid(), NULL, NULL);

-- Capture the three entries by their unique sequence numbers before adding related rows.
SELECT ale_id AS bulk_entry_ale_id_1, id AS bulk_entry_id_1
FROM appreg.application_list_entries
WHERE al_al_id = :bulk_target_list_al_id AND sequence_number = 1
\gset
SELECT ale_id AS bulk_entry_ale_id_2, id AS bulk_entry_id_2
FROM appreg.application_list_entries
WHERE al_al_id = :bulk_target_list_al_id AND sequence_number = 2
\gset
SELECT ale_id AS bulk_entry_ale_id_3, id AS bulk_entry_id_3
FROM appreg.application_list_entries
WHERE al_al_id = :bulk_target_list_al_id AND sequence_number = 3
\gset

INSERT INTO appreg.al_ale_sequence_mapping (al_id, ale_last_sequence)
VALUES (:bulk_target_list_al_id, 3);

