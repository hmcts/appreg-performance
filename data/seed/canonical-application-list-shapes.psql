  'B03DE00', NULL, 'PERF-SEED-BULK-TARGET', 0,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test',
  'Carlisle Magistrates'' Court', 1, 0, NULL, gen_random_uuid(),
  NULL, NULL, 'N', false
) RETURNING al_id AS bulk_target_list_al_id, id AS bulk_target_list_id
\gset

