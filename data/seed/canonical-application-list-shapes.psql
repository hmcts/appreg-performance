-- Canonical AppReg Test seed shapes.
--
-- Run with psql, not through a generic SQL editor: this script uses \gset to pass IDs returned
-- by PostgreSQL safely to later statements. It is deliberately one transaction: psql stops on
-- the first error and PostgreSQL rolls the whole seed run back.
--
-- The numeric reference IDs below are currently Test-environment-specific. Before every database
-- refresh, validate that 8, 236 and 7 still identify the agreed active application code, fee and
-- result code respectively. ARCPOC-1633 will parameterise the workflow/allocation labels and
-- scale these canonical shapes into independently allocated data sets.

\set ON_ERROR_STOP on

BEGIN;

-- Stable audit values for synthetic Test data only.
-- CURRENT_TIMESTAMP is constant throughout this transaction.

-- 1. Empty OPEN list: bulk upload creates its entries through the UI.
INSERT INTO appreg.application_lists (
  al_id, application_list_status, application_list_date, application_list_time,
  courthouse_code, other_courthouse, list_description, version, changed_by,
  changed_date, user_name, courthouse_name, duration_hour, duration_minute,
  cja_cja_id, id, delete_by, delete_date, is_deleted, child_deleted
) VALUES (
  nextval('appreg.al_seq'), 'OPEN', CURRENT_DATE, '10:00:00',
  'B03DE00', NULL, 'PERF-SEED-BULK-UPLOAD', 0,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test',
  'Carlisle Magistrates'' Court', 1, 0, NULL, gen_random_uuid(),
  NULL, NULL, 'N', false
) RETURNING al_id AS bulk_upload_al_id, id AS bulk_upload_list_id
\gset

-- 2. Complete editable entry: one list and one independently editable entry.
INSERT INTO appreg.application_lists (
  al_id, application_list_status, application_list_date, application_list_time,
  courthouse_code, other_courthouse, list_description, version, changed_by,
  changed_date, user_name, courthouse_name, duration_hour, duration_minute,
  cja_cja_id, id, delete_by, delete_date, is_deleted, child_deleted
) VALUES (
  nextval('appreg.al_seq'), 'OPEN', CURRENT_DATE, '10:00:00',
  'B03DE00', NULL, 'PERF-SEED-EDITABLE-ENTRY', 0,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test',
  'Carlisle Magistrates'' Court', 1, 0, NULL, gen_random_uuid(),
  NULL, NULL, 'N', false
) RETURNING al_id AS editable_list_al_id, id AS editable_list_id
\gset

INSERT INTO appreg.name_address (
  na_id, code, name, title, address_l1, address_l2, address_l3, address_l4,
  address_l5, postcode, email_address, telephone_number, mobile_number, version,
  changed_by, changed_date, user_name, date_of_birth, dms_id, first_name,
  middle_name, last_name
) VALUES (
  nextval('appreg.na_seq'), 'NA', 'PERFORMANCE APPLICANT', NULL,
  '1 TEST STREET', 'TEST SUBURB', 'TEST TOWN', 'TEST COUNTY', 'TEST ADDRESS',
  'AB1 1AA', 'applicant@example.invalid', '01234567890', '07123456789', 1,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test', NULL, NULL, NULL, NULL, NULL
) RETURNING na_id AS editable_applicant_id
\gset

INSERT INTO appreg.name_address (
  na_id, code, name, title, address_l1, address_l2, address_l3, address_l4,
  address_l5, postcode, email_address, telephone_number, mobile_number, version,
  changed_by, changed_date, user_name, date_of_birth, dms_id, first_name,
  middle_name, last_name
) VALUES (
  nextval('appreg.na_seq'), 'RE', NULL, 'MR',
  '2 TEST STREET', 'TEST SUBURB', 'TEST TOWN', 'TEST COUNTY', 'TEST ADDRESS',
  'AB2 2AA', 'respondent@example.invalid', '01234567890', '07123456789', 1,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test', NULL, NULL,
  'TEST', 'PERFORMANCE', 'RESPONDENT'
) RETURNING na_id AS editable_respondent_id
\gset

INSERT INTO appreg.application_list_entries (
  ale_id, al_al_id, sa_sa_id, ac_ac_id, a_na_id, r_na_id, number_of_bulk_respondents,
  application_list_entry_wording, case_reference, account_number, entry_rescheduled,
  notes, version, changed_by, changed_date, bulk_upload, user_name, sequence_number,
  tcep_status, message_uuid, retry_count, lodgement_date, id, delete_by, delete_date
) VALUES (
  nextval('appreg.ale_seq'), :editable_list_al_id, NULL, 8, :editable_applicant_id,
  :editable_respondent_id, NULL,
  'Notice of appeal to the High Court by way of case stated in respect of case heard on {TEXT|10/08/2026|10}',
  NULL, NULL, 'N', NULL, 1, 'Performance.Test', CURRENT_TIMESTAMP, NULL,
  'Performance.Test', 1, NULL, NULL, NULL, CURRENT_DATE::timestamp,
  gen_random_uuid(), NULL, NULL
) RETURNING ale_id AS editable_entry_ale_id, id AS editable_entry_id
\gset

INSERT INTO appreg.al_ale_sequence_mapping (al_id, ale_last_sequence)
VALUES (:editable_list_al_id, 1);

INSERT INTO appreg.app_list_entry_fee_id (
  ale_ale_id, fee_fee_id, version, changed_by, changed_date, user_name
) VALUES (:editable_entry_ale_id, 236, 1, 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test');

INSERT INTO appreg.app_list_entry_official (
  aleo_id, ale_ale_id, title, forename, surname, official_type, changed_by, changed_date, user_name
) VALUES
  (nextval('appreg.aleo_seq'), :editable_entry_ale_id, 'MR', 'MAGISTRATE', 'ONE', 'M', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :editable_entry_ale_id, 'MR', 'MAGISTRATE', 'TWO', 'M', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :editable_entry_ale_id, 'MR', 'CLERK', 'ONE', 'C', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test');

-- 3. Close-ready list: do not reuse it for ordinary update traffic.
INSERT INTO appreg.application_lists (
  al_id, application_list_status, application_list_date, application_list_time,
  courthouse_code, other_courthouse, list_description, version, changed_by,
