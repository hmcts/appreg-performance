\gset

INSERT INTO appreg.application_list_entries (
  ale_id, al_al_id, sa_sa_id, ac_ac_id, a_na_id, r_na_id, number_of_bulk_respondents,
  application_list_entry_wording, case_reference, account_number, entry_rescheduled,
  notes, version, changed_by, changed_date, bulk_upload, user_name, sequence_number,
  tcep_status, message_uuid, retry_count, lodgement_date, id, delete_by, delete_date
) VALUES (
  nextval('appreg.ale_seq'), :single_result_list_al_id, NULL, :canonical_application_code_id,
  :single_result_applicant_id, :single_result_respondent_id, NULL, '', NULL, NULL, 'N', NULL,
  1, 'Performance.Test', CURRENT_TIMESTAMP, NULL, 'Performance.Test', 1, NULL, NULL, NULL,
  CURRENT_DATE::timestamp, gen_random_uuid(), NULL, NULL
) RETURNING ale_id AS single_result_entry_ale_id, id AS single_result_entry_id
\gset

INSERT INTO appreg.al_ale_sequence_mapping (al_id, ale_last_sequence)
VALUES (:single_result_list_al_id, 1);

INSERT INTO appreg.app_list_entry_fee_id (
  ale_ale_id, fee_fee_id, version, changed_by, changed_date, user_name
