-- Canonical AppReg Test seed shapes.
--
-- Run with psql, not through a generic SQL editor: this script uses \gset to pass IDs returned
-- by PostgreSQL safely to later statements. It is deliberately one transaction: psql stops on
-- the first error and PostgreSQL rolls the whole seed run back.
--
-- The numeric fee ID below is currently Test-environment-specific. Application and result codes
-- use stable business codes rather than database IDs so seed-only runs do not depend on reference
-- data sequences. Before every database refresh, validate that fee ID 236 is still appropriate.
-- ARCPOC-1633 will parameterise workflow/allocation labels and scale these canonical shapes into
-- independently allocated data sets.

\set ON_ERROR_STOP on

BEGIN;

-- A masked-database reload can leave the legacy numeric sequences behind existing rows.
-- Advance, never rewind, the sequences used by this script so seed-only pipeline runs remain
-- repeatable without a full database reset.
SELECT setval('appreg.al_seq', GREATEST(
  (SELECT last_value FROM appreg.al_seq),
  COALESCE((SELECT MAX(al_id) FROM appreg.application_lists), 0)
), true);
SELECT setval('appreg.na_seq', GREATEST(
  (SELECT last_value FROM appreg.na_seq),
  COALESCE((SELECT MAX(na_id) FROM appreg.name_address), 0)
), true);
SELECT setval('appreg.ale_seq', GREATEST(
  (SELECT last_value FROM appreg.ale_seq),
  COALESCE((SELECT MAX(ale_id) FROM appreg.application_list_entries), 0)
), true);
SELECT setval('appreg.aleo_seq', GREATEST(
  (SELECT last_value FROM appreg.aleo_seq),
  COALESCE((SELECT MAX(aleo_id) FROM appreg.app_list_entry_official), 0)
), true);
SELECT setval('appreg.alefs_seq', GREATEST(
  (SELECT last_value FROM appreg.alefs_seq),
  COALESCE((SELECT MAX(alefs_id) FROM appreg.app_list_entry_fee_status), 0)
), true);
SELECT setval('appreg.aler_seq', GREATEST(
  (SELECT last_value FROM appreg.aler_seq),
  COALESCE((SELECT MAX(aler_id) FROM appreg.app_list_entry_resolutions), 0)
), true);

-- AD99001 is the agreed no-wording-field code used by the curated Add and Update Application proofs.
SELECT ac_id AS canonical_application_code_id
FROM appreg.application_codes
WHERE application_code = 'AD99001'
LIMIT 1
\gset

-- Stable audit values for synthetic Test data only.
-- CURRENT_TIMESTAMP is constant throughout this transaction.

-- 1. Empty OPEN list: bulk upload creates its entries through the UI.
INSERT INTO appreg.application_lists (
  al_id, application_list_status, application_list_date, application_list_time,
  courthouse_code, other_courthouse, list_description, version, changed_by,
  changed_date, user_name, courthouse_name, duration_hour, duration_minute,
  cja_cja_id, id, delete_by, delete_date, is_deleted, child_deleted
) VALUES (
  nextval('appreg.al_seq'), 'OPEN', CURRENT_DATE, '10:00:00',
  'B03DE00', NULL, 'PERF-SEED-BULK-UPLOAD', 0,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test',
  'Carlisle Magistrates'' Court', 1, 0, NULL, gen_random_uuid(),
  NULL, NULL, 'N', false
) RETURNING al_id AS bulk_upload_al_id, id AS bulk_upload_list_id
\gset

-- 2. Empty OPEN list: Add Application creates and completes its entry through the UI.
INSERT INTO appreg.application_lists (
  al_id, application_list_status, application_list_date, application_list_time,
  courthouse_code, other_courthouse, list_description, version, changed_by,
  changed_date, user_name, courthouse_name, duration_hour, duration_minute,
  cja_cja_id, id, delete_by, delete_date, is_deleted, child_deleted
) VALUES (
  nextval('appreg.al_seq'), 'OPEN', CURRENT_DATE, '10:00:00',
  'B03DE00', NULL, 'PERF-SEED-ADD-APPLICATION', 0,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test',
  'Carlisle Magistrates'' Court', 1, 0, NULL, gen_random_uuid(),
  NULL, NULL, 'N', false
) RETURNING al_id AS add_application_al_id, id AS add_application_list_id
\gset

-- 3. One completed, unresulted Application: single-result proof target.
INSERT INTO appreg.application_lists (
  al_id, application_list_status, application_list_date, application_list_time,
  courthouse_code, other_courthouse, list_description, version, changed_by,
  changed_date, user_name, courthouse_name, duration_hour, duration_minute,
  cja_cja_id, id, delete_by, delete_date, is_deleted, child_deleted
) VALUES (
  nextval('appreg.al_seq'), 'OPEN', CURRENT_DATE, '10:00:00',
  'B03DE00', NULL, 'PERF-SEED-SINGLE-RESULT', 0,
  'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test',
  'Carlisle Magistrates'' Court', 1, 0, NULL, gen_random_uuid(),
  NULL, NULL, 'N', false
) RETURNING al_id AS single_result_list_al_id, id AS single_result_list_id
\gset

INSERT INTO appreg.name_address (
  na_id, code, name, title, address_l1, address_l2, address_l3, address_l4,
  address_l5, postcode, email_address, telephone_number, mobile_number, version,
