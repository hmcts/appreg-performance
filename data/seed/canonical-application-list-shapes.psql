-- IDs for the provisioning job to persist as allocated feeder data.
SELECT
  :'bulk_upload_list_id'::uuid AS bulk_upload_list_id,
  :'editable_list_id'::uuid AS editable_list_id,
  :'editable_entry_id'::uuid AS editable_entry_id,
  :'close_ready_list_id'::uuid AS close_ready_list_id,
  :'close_ready_entry_id'::uuid AS close_ready_entry_id,
  :'bulk_target_list_id'::uuid AS bulk_target_list_id,
  :'bulk_entry_id_1'::uuid AS bulk_entry_id_1,
  :'bulk_entry_id_2'::uuid AS bulk_entry_id_2,
  :'bulk_entry_id_3'::uuid AS bulk_entry_id_3,
  :'add_application_list_id'::uuid AS add_application_list_id,
  :'single_result_list_id'::uuid AS single_result_list_id,
  :'single_result_entry_id'::uuid AS single_result_entry_id,
  :'bulk_fees_list_id'::uuid AS bulk_fees_list_id,
  :'bulk_fees_entry_id_1'::uuid AS bulk_fees_entry_id_1,
  :'bulk_fees_entry_id_2'::uuid AS bulk_fees_entry_id_2,
  :'bulk_fees_entry_id_3'::uuid AS bulk_fees_entry_id_3,
  :'bulk_officials_list_id'::uuid AS bulk_officials_list_id,
  :'bulk_officials_entry_id_1'::uuid AS bulk_officials_entry_id_1,
  :'bulk_officials_entry_id_2'::uuid AS bulk_officials_entry_id_2,
  :'bulk_officials_entry_id_3'::uuid AS bulk_officials_entry_id_3;
