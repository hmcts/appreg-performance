  (nextval('appreg.aleo_seq'), :bulk_entry_ale_id_1, 'MR', 'BULK', 'MAGISTRATE', 'M', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :bulk_entry_ale_id_1, 'MR', 'BULK', 'CLERK', 'C', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :bulk_entry_ale_id_2, 'MR', 'BULK', 'MAGISTRATE', 'M', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :bulk_entry_ale_id_2, 'MR', 'BULK', 'CLERK', 'C', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :bulk_entry_ale_id_3, 'MR', 'BULK', 'MAGISTRATE', 'M', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test'),
  (nextval('appreg.aleo_seq'), :bulk_entry_ale_id_3, 'MR', 'BULK', 'CLERK', 'C', 'Performance.Test', CURRENT_TIMESTAMP, 'Performance.Test');

-- No resolution rows are inserted for the bulk target.

COMMIT;

-- IDs for the provisioning job to persist as allocated feeder data.
SELECT
  :'bulk_upload_list_id'::uuid AS bulk_upload_list_id,
  :'editable_list_id'::uuid AS editable_list_id,
  :'editable_entry_id'::uuid AS editable_entry_id,
  :'close_ready_list_id'::uuid AS close_ready_list_id,
  :'close_ready_entry_id'::uuid AS close_ready_entry_id,
  :'bulk_target_list_id'::uuid AS bulk_target_list_id,
  :'bulk_entry_id_1'::uuid AS bulk_entry_id_1,
  :'bulk_entry_id_2'::uuid AS bulk_entry_id_2,
  :'bulk_entry_id_3'::uuid AS bulk_entry_id_3;
